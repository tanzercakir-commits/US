module fixtures/cases/sum_loop.cpp
function sum_zero_to_n(n#0:int) -> int
  requires ((n#0 >= 0) && (n#0 <= 10))
  ensures ((result >= 0) && (result <= 100))
  n00001 assume ((n#0 >= 0) && (n#0 <= 10))
  n00002 i#0 := 0
  n00003 total#0 := 0
  n00004 loop (i#1 < n#0)
    termination non_goal (partial correctness only)
